#!/bin/bash
# Installs the Python libraries Mesh Chat needs into a private venv, and
# checks that this user can open USB serial radios. Never uses sudo.

set -euo pipefail

VENV="${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-mesh/venv"

if [[ ! -x "$VENV/bin/python" ]]; then
  echo "Creating $VENV"
  python3 -m venv "$VENV"
fi

echo "Installing meshtastic and meshcore"
"$VENV/bin/pip" install --quiet --upgrade "meshtastic>=2.7,<3" "meshcore>=2.3,<3"
"$VENV/bin/pip" list 2>/dev/null | grep -Ei '^(meshtastic|meshcore) '

if ! id -nG | tr ' ' '\n' | grep -qx uucp; then
  echo
  echo "To use a USB radio, add yourself to the uucp group, then log out and back in:"
  echo "  sudo usermod -aG uucp $USER"
fi
